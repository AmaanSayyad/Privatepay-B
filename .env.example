# Private-Pay — BOT Chain mainnet
# Copy to .env and fill in values. Never commit .env.
# See BOTCHAIN_MIGRATION.md for the migration plan.

# --- Database: Neon Postgres (replaces Supabase) ---
# Pooled connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct (non-pooled) URL — used for migrations only
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- BOT Chain ---
# mainnet | testnet
VITE_BOTCHAIN_NETWORK=mainnet
# Optional overrides (defaults baked into src/botchain.js)
# VITE_BOTCHAIN_CHAIN_ID=677
# VITE_BOTCHAIN_RPC_URL=https://rpc.botchain.ai
# VITE_BOTCHAIN_EXPLORER=https://scan.botchain.ai
# VITE_BOTCHAIN_USDT_ADDRESS=0xababc7ddc03e501d190c676bf3d92ef0e6e87a3c

# --- Treasury (PrivatePayTreasury on BOT Chain) ---
# Set after `npm run contract:deploy` — see deployments/botchain-677.json
VITE_SHARED_TREASURY_ADDRESS=
VITE_BASE_TREASURY_ADDRESS=

# --- Contract deployment (server only) ---
DEPLOYER_PRIVATE_KEY=
RELAYER_ADDRESS=
# BOTCHAIN_RPC_URL=https://rpc.botchain.ai
# BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life

# --- Relayer / withdraw (server only; keep secret) ---
TREASURY_PRIVATE_KEY=

# --- Optional ---
# VITE_WEBSITE_HOST=privatepay-production.up.railway.app
# VITE_BACKEND_URL=http://localhost:3400
